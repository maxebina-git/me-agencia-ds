{
  "name": "@maxebina/max-ds",
  "version": "1.0.11",
  "type": "module",
  "description": "Design System da Agência Max Ebina - Templates Instagram, Landing Pages e componentes reutilizáveis",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/max-ds.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --mode lib && npm run build:types",
    "build:types": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build:lib",
    "preview": "vite preview"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "instagram",
    "landing-page",
    "max-ebina",
    "templates",
    "ui-components"
  ],
  "author": "Max Ebina",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxebina-git/me-agencia-ds.git"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.98.0",
    "canvas-confetti": "^1.9.3",
    "date-fns": "^2.30.0",
    "framer-motion": "^11.16.1",
    "lucide-react": "^0.294.0",
    "react-router-dom": "^6.8.0",
    "recharts": "^2.10.0",
    "three": "^0.187.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "vite": "^6.3.5"
  }
}
